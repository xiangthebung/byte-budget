node_modules/

# Build output. Generated by `npm run build` / `npm run build:throttle`; never
# committed, so a stale dist/ can never disagree with source.
dist/
dist-throttle/

# Store upload artifacts, produced by `npm run zip`.
artifacts/
*.zip

# Screenshots from `npm run smoke -- --shots`.
outputs/

# Generated by the build so `chrome://extensions` can load the project root
# directly instead of making you descend into dist/. Points into dist/; never
# packaged. See writeRootManifest in vite.config.ts.
/manifest.json

# The other half of that arrangement. Chrome resolves `_locales` relative to the
# manifest and follows no path to it, so the root manifest above cannot point at
# dist/_locales the way it points at every script — the catalogue has to sit beside
# it. Generated by merge-locales from the i18n/*.json partials, which ARE the source
# and are tracked. Never packaged; scripts/package.mjs collects from dist/.
/_locales/

# tsc writes one of these the moment anyone turns on `incremental`, and it is a
# cache of the last compile — committing it makes CI's typecheck depend on
# whichever machine wrote it last.
*.tsbuildinfo

# Vite loads .env files from the project root automatically. There are none
# today; this is here so that if one ever appears it is not committed by
# reflex along with whatever is in it.
.env
.env.*
!.env.example

# OS and editor droppings. .DS_Store was already covered; the Windows and
# JetBrains/VS Code equivalents were not, and this project is developed on
# Windows, so the asymmetry was the more likely accident.
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.vscode/
.idea/

*.log
