{
  "name": "byte-budget",
  "private": true,
  "version": "0.1.0",
  "description": "Chrome extension that measures per-site network usage, holds sites to a byte budget, and reports what optimizing them actually saved.",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:throttle": "tsc --noEmit && vite build --mode throttle",
    "build:all": "npm run build && npm run build:throttle",
    "watch": "vite build --watch",
    "zip": "npm run build && node scripts/package.mjs",
    "zip:throttle": "npm run build:throttle && node scripts/package.mjs --throttle",
    "clean": "node -e \"for (const d of ['dist','dist-throttle','artifacts']) fs.rmSync(d,{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register-hooks.mjs --test \"tests/*.test.mjs\"",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "store:assets": "npm run build && node scripts/smoke.mjs --store-assets",
    "icon": "node scripts/make-icon.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "eslint": "10.8.1",
    "playwright": "1.62.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.66.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
